---
import { fit, TITLE_RANGE, DESC_RANGE } from '../../../lib/snippet';
import GuideLayout from "../../../layouts/GuideLayout.astro";
import { corridors } from "../../../data/corridors";
import { destinationCities } from "../../../data/destination-cities";
import { buildBreadcrumbs, buildFAQSchema } from "../../../lib/seo";
import RelatedLinks from "../../../components/ui/RelatedLinks.astro";
import SourcesBlock from "../../../components/ui/SourcesBlock.astro";
import FAQAccordion from "../../../components/ui/FAQAccordion.astro";

export function getStaticPaths() {
  return corridors.map((c) => ({
    params: { country: c.slug },
    props: { corridor: c },
  }));
}

const { corridor } = Astro.props;

const faqs = [
  { question: `What salary can I expect in the Gulf as a ${corridor.demonym} professional?`, answer: `Gulf salaries for ${corridor.demonym} professionals are typically ${corridor.avgSalaryRange}. Salaries are tax-free in all three Gulf countries, which lifts net pay well above the equivalent gross figure at home. Compare the full package rather than the headline: housing allowance, annual flights and family health cover commonly add a quarter to a third, while end-of-service gratuity accrues on the basic salary alone.` },
  { question: `What documents do I need to relocate from ${corridor.country}?`, answer: `Key documents include: ${corridor.documentsNeeded.slice(0, 4).join(", ")}. Additional documents may be required depending on the destination country and profession. Degree certificates almost always need attestation, first in your home country and then at the destination embassy, a process that takes several weeks and is the single most common cause of delay in a Gulf relocation.` },
  { question: `How long does the visa process take from ${corridor.country}?`, answer: `Standard work visa processing takes 2-8 weeks depending on the Gulf country and completeness of documentation. Credential attestation should be started before departure, since it runs through your home authorities first. The medical test and biometrics, by contrast, are completed after arrival. Nothing can begin before a signed offer exists, because the employer sponsors the permit and lodges the application on your behalf.` },
  { question: `Is it worth relocating from ${corridor.country} to the Gulf?`, answer: `The financial benefits are significant: tax-free salaries, employer-provided housing and flights, and strong savings potential. ${corridor.costComparison.slice(0, 200)} Against that, weigh schooling costs for children, the year of rent often payable in advance, and the fact that residence depends on continued employment.` },
  { question: `What is the ${corridor.demonym} community like in the Gulf?`, answer: `The ${corridor.demonym} community is well-established in all Gulf countries, and it is usually the fastest route to reliable advice on housing, schools and employers. ${corridor.communityResources.slice(0, 3).join(", ")} are among the available community resources, alongside professional associations and the embassy's own registration service.` },
  { question: `Which Gulf country is best for ${corridor.demonym} expats?`, answer: `Each country has strengths: UAE offers the most cosmopolitan lifestyle and diverse economy; Saudi Arabia has the largest projects and lowest cost of living; Qatar offers a compact, well-funded environment. The best choice depends on your profession, family situation, and lifestyle preferences.` },
];

const otherCorridors = corridors.filter((c) => c.slug !== corridor.slug).slice(0, 5);

const breadcrumbs = [
  { name: "Home", url: "https://arabiaexpat.com/" },
  { name: "Relocating From", url: "https://arabiaexpat.com/relocating-from/india/" },
  { name: corridor.country, url: `https://arabiaexpat.com/relocating-from/${corridor.slug}/` },
];
const pageTitle = fit(`Moving to the Gulf from ${corridor.country} 2026`,
  [': Full Relocation Checklist', ': Relocation Checklist', ': Full Checklist', ': Checklist', ''], TITLE_RANGE, 'title');
const metaDescription = fit(`Moving to the Gulf from ${corridor.country} in 2026:`, [
  ` visa documents, salary expectations, cost of living comparison, schools, cultural tips and ${corridor.demonym} community resources.`,
  ` visa documents, salary expectations, cost of living comparison, cultural tips and ${corridor.demonym} community resources.`,
  ` visa documents, salary expectations, cost comparison, schools, cultural tips and ${corridor.demonym} community resources.`,
  ` visa documents, salary expectations, cost comparison, cultural tips and ${corridor.demonym} community resources.`,
  ` visa documents, salary expectations, cost comparison, cultural tips and community resources.`,
], DESC_RANGE, 'description');
---

<GuideLayout
  title={pageTitle}
  description={metaDescription}
  canonical={`/relocating-from/${corridor.slug}/`}
  schemas={[buildBreadcrumbs(breadcrumbs), buildFAQSchema(faqs)]}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Relocating From", url: "/relocating-from/india/" }, { name: corridor.country, url: `/relocating-from/${corridor.slug}/` }]}
>
  <h1>Relocating from {corridor.country} to the Gulf in 2026</h1>

  <div class="not-prose mb-6 p-4 bg-teal-50 dark:bg-teal-900/20 rounded-2xl">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
      <div>
        <p class="text-gray-500 dark:text-gray-400">Popular Destinations</p>
        <p class="font-medium text-gray-900 dark:text-white">{corridor.popularDestinations.join(", ")}</p>
      </div>
      <div>
        <p class="text-gray-500 dark:text-gray-400">Salary Premium</p>
        <p class="font-medium text-gray-900 dark:text-white">{corridor.avgSalaryRange}</p>
      </div>
    </div>
  </div>

  <h2>Choose Your Destination City</h2>
  <div class="not-prose grid grid-cols-2 sm:grid-cols-3 gap-3 my-6">
    {destinationCities.map((city) => (
      <a href={`/relocating-from/${corridor.slug}/to-${city.slug}/`} class="group bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg p-4 hover:border-teal-400 dark:hover:border-teal-500 hover:shadow-md transition-all">
        <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors text-sm">{corridor.country} to {city.name}</h3>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">City-specific guide, costs, and tips</p>
      </a>
    ))}
  </div>

  {corridor.content.split("\n\n").map((paragraph) => (
    <p>{paragraph}</p>
  ))}

  <h2>Visa Process from {corridor.country}</h2>
  <p>{corridor.visaProcess}</p>

  <h2>Documents Required</h2>
  <ul>
    {corridor.documentsNeeded.map((doc) => <li>{doc}</li>)}
  </ul>

  <h2>Cost Comparison</h2>
  <p>{corridor.costComparison}</p>

  <h2>Cultural Tips for {corridor.demonym} Expats</h2>
  <ul>
    {corridor.culturalTips.map((tip) => <li>{tip}</li>)}
  </ul>

  <h2>Community Resources</h2>
  <ul>
    {corridor.communityResources.map((r) => <li>{r}</li>)}
  </ul>

  <FAQAccordion faqs={faqs} />

  <SourcesBlock sources={[
    { name: "UAE MoHRE", url: "https://www.mohre.gov.ae/" },
    { name: "Saudi MHRSD", url: "https://hrsd.gov.sa/" },
    { name: "Qatar MADLSA", url: "https://www.adlsa.gov.qa/" },
  ]} />

  <RelatedLinks
    title="Other Relocation Guides"
    links={otherCorridors.map((c) => ({
      label: `Relocating from ${c.country} to the Gulf`,
      href: `/relocating-from/${c.slug}/`,
    }))}
  />
</GuideLayout>
