---
import Layout from "./Layout.astro";
import { SITE } from "../data/site-config";
import FAQAccordion from "../components/ui/FAQAccordion.astro";
import SourcesBlock from "../components/ui/SourcesBlock.astro";
import RelatedLinks from "../components/ui/RelatedLinks.astro";

interface Props {
  /** Paragraphe citable (RECETTE §21), rendu dans le corps. */
  resumeCitable?: string;
  title: string;
  description: string;
  canonical: string;
  schemas?: object[];
  breadcrumbs: { name: string; url: string }[];
  lastUpdated?: string;
  faqs?: { question: string; answer: string }[];
  sources?: { name: string; url: string }[];
  relatedLinks?: { label: string; href: string }[];
  crossLinks?: { label: string; href: string; description?: string }[];
}

const {
  title,
  description,
  canonical,
  schemas = [],
  breadcrumbs,
  lastUpdated = "June 2026",
  faqs = [],
  sources = [],
  relatedLinks = [],
  crossLinks = [],
  resumeCitable,
} = Astro.props;
// Premier écran (RECETTE §5, règle du 2026-10-11) : le titre de la page vient d'abord, puis le
// simulateur ; le paragraphe citable et les liens croisés passent juste en dessous. Le corps est
// coupé après le H1 ; rien n'est réécrit.
const corps = await Astro.slots.render("default");
const finH1 = corps.indexOf("</h1>");
const tete = finH1 < 0 ? "" : corps.slice(0, finH1 + 5);
const suite = finH1 < 0 ? corps : corps.slice(finH1 + 5);
const prose = "prose prose-lg dark:prose-invert prose-teal max-w-none prose-headings:scroll-mt-20 prose-headings:font-serif prose-a:text-teal-600 dark:prose-a:text-teal-400";
---

<Layout title={title} description={description} canonical={canonical} schemas={schemas}>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pt-4 pb-8">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400">
        {breadcrumbs.map((crumb, i) => (
          <li class="flex items-center gap-1.5">
            {i > 0 && <span>/</span>}
            {i === breadcrumbs.length - 1 ? (
              <span class="text-gray-900 dark:text-gray-100 font-medium">{crumb.name}</span>
            ) : (
              <a href={crumb.url} class="hover:text-teal-600 dark:hover:text-teal-400 transition-colors">{crumb.name}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <div class="flex flex-wrap items-center gap-x-3 text-sm text-gray-500 dark:text-gray-400">
      <span>By <strong class="text-gray-700 dark:text-gray-300">{SITE.author.name}</strong>, {SITE.author.credentials}</span>
      <span>&middot;</span>
      <time>Updated {lastUpdated}</time>
    </div>
    <div data-date-ici></div>
    </div>

    {tete && <div class={`${prose} prose-h1:mb-4`} set:html={tete} />}

    <!-- Simulator slot (rendered just under the title) -->
    <div data-simu class="mb-6"><slot name="simulator" /></div>

    {resumeCitable && (
      <p class="mb-8 leading-relaxed text-gray-700 dark:text-gray-300">{resumeCitable}</p>
    )}

    <!-- Cross-links to same theme in other countries -->
    {crossLinks.length > 0 && (
      <nav class="mb-8 py-3 border-y border-gray-200 dark:border-gray-800">
        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Same topic in other countries</p>
        <div class="flex flex-wrap gap-2">
          {crossLinks.map((link) => (
            <a href={link.href} class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:text-teal-600 dark:hover:text-teal-400 hover:border-teal-400 dark:hover:border-teal-500 transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </nav>
    )}

    <div class={prose} set:html={suite} />

    {faqs.length > 0 && <FAQAccordion faqs={faqs} />}
    {sources.length > 0 && <SourcesBlock sources={sources} />}
    {relatedLinks.length > 0 && <RelatedLinks links={relatedLinks} />}

    <div class="mt-8 p-4 bg-gray-50 dark:bg-gray-800 rounded-lg text-sm text-gray-600 dark:text-gray-400">
      <p>Written by {SITE.author.name}, {SITE.author.credentials} &middot; Last updated {lastUpdated}</p>
    </div>
  </article>
</Layout>
